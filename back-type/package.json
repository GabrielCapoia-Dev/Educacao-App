{
  "name": "gestao-edu-api",
  "version": "0.1.0",
  "private": true,
  "description": "API TypeScript para a futura separação do backend do Gestão Edu",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "oracledb": "^7.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/oracledb": "^7.0.3",
    "tsx": "^4.20.5",
    "typescript": "^7.0.0"
  }
}
